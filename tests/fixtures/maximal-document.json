      "content": {
        "paragraphs": [
          {
            "runs": [
              {
                "text": "Charlotte showed up the way good things do: quietly, then all at once."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "blockaaaaaac",
      "type": "bio",
      "content": {
        "paragraphs": [
          {
            "runs": [
              { "text": "She is " },
              { "text": "endlessly patient", "bold": true },
              { "text": " with new people, even the loud ones." }
            ]
          }
        ]
      }
    },
    {
      "id": "blockaaaaaad",
      "type": "bio",
      "content": {
        "paragraphs": [
          {
            "runs": [
              { "text": "Her favorite hour is " },
              { "text": "golden hour", "italic": true },
              { "text": ", spent entirely by the window." }
            ]
          }
        ]
      }
    },
    {
      "id": "blockaaaaaae",
      "type": "bio",
      "content": {
        "paragraphs": [
          {
            "runs": [
              { "text": "Read more about her foster journey " },
              { "text": "here", "href": "https://example.org/charlotte" },
              { "text": "." }
            ]
          }
        ]
      }
    },
    {
      "id": "blockaaaaaaf",
      "type": "bio",
      "content": {
        "paragraphs": [
          {
            "runs": [
              { "text": "Charlotte in her own words: " },
              {
                "text": "soft, curious, a little dramatic.",
                "bold": true,
                "italic": true,
                "href": "https://example.org/charlotte/story"
              }
            ]
          },
          {
            "runs": [{ "text": "She will trade a nap for a scratch behind the ears any day." }]
          }
        ]
      }
    },
