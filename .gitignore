# Dependencies and build output
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
# Generated by `next typegen`, `next dev` and `next build`
next-env.d.ts

# Local profile and media store when STORE=fs (ADR-015); the e2e run uses its own copy
.data/
.data-e2e/

# Environment and secrets. Provider keys live here and MUST NEVER be committed
# (constitution, Engineering Standards → Logging and secrets).
.env
.env.*
!.env.example

# Test coverage and runner output
coverage/
playwright-report/
test-results/

# Machine-local Claude Code state, including Playwright MCP browser-check output
.claude/settings.local.json
.playwright-mcp/

# Sample cat photos and videos used while developing. ~275MB, one file over
# GitHub's 100MB limit, and media belongs in the media store rather than the
# repository (constitution, Engineering Standards).
test-media/

# Vendored Spec Kit extension. Ships with its own .git directory, so committing
# it would record a broken embedded repository rather than its files. Reinstall
# it with the Specify CLI; its configuration in .specify/extensions.yml and
# .specify/extensions/.registry IS tracked.
.specify/extensions/superspec/

# OS noise
.DS_Store
Thumbs.db
.claude/worktrees/

# Spec-kit tool cache and the per-tool integration manifest are local
.specify/extensions/.cache/
.specify/integrations/claude.manifest.json
