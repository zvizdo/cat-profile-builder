  "breakpoints": {
    "full": ">=1440",
    "helperAsTab": "1180-1439",
    "touch": "768-1179",
    "phone": "<768",
    "phoneLandscape": "height <480 at any width"
  },
  "touchTarget": { "min": 44 },
  "media": {
    "photo": { "formats": ["jpeg", "png", "heic"], "maxBytes": 26214400, "minWidthHero": 1600, "minWidthGallery": 1200, "maxPerGallery": 12, "tooSmall": "warn, never block" },
    "video": { "formats": ["mp4", "mov"], "maxBytes": 524288000, "maxSeconds": 180, "carouselTrim": [4, 12], "profileTrim": [0, 30], "muted": true, "loops": true },
    "crop": "derived from per-photo focal point {x,y} as background-position against cover",
    "altText": "required before publish",
    "uploadFailure": "atomic — never partially applies"
  },
  "icon": { "box": 20, "stroke": 1.5, "fill": "none", "color": "currentColor", "library": "Lucide for anything beyond the twelve geometric ones" },
  "toast": { "position": "bottom-left", "radius": 4, "shadow": "lifted", "autoDismissMs": 6000, "persist": ["warning", "error"], "concurrent": 1 }
}
