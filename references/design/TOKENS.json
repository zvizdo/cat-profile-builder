{
  "$comment": "South County Cats — design tokens. Values are final; names are suggestions. Canonical prose: DESIGN.md",
  "color": {
    "blue": { "value": "#0B6FB4", "use": "primary buttons, selection, links, fee cell", "contrast": { "onPaper": 5.0, "withWhite": 5.3 } },
    "blueDeep": { "value": "#0A3D63", "use": "CTA grounds, primary hover", "contrast": { "withWhite": 11.2 } },
    "blueLight": { "value": "#8FD0FF", "use": "labels on night grounds", "contrast": { "onNight": 11.7 } },
    "blueWhisper": { "value": "#C9E7FF", "use": "kickers over photography" },
    "clay": { "value": "#A4552A", "use": "destructive actions, warnings only" },
    "ink": { "value": "#231F20", "use": "headings", "contrast": { "onPaper": 15.0 } },
    "body": { "value": "#3D3937", "use": "paragraphs", "contrast": { "onPaper": 11.3 } },
    "meta": { "value": "#6F6A63", "use": "mono labels, captions — text floor", "contrast": { "onPaper": 4.9 } },
    "rule": { "value": "#8A857E", "use": "HAIRLINES ONLY, never text", "contrast": { "onPaper": 3.3 } },
    "paper": { "value": "#F6F4F0", "use": "page ground" },
    "paperDeep": { "value": "#E9E6E1", "use": "canvas ground behind frames" },
    "card": { "value": "#FFFFFF", "use": "panels, facts strip" },
    "night": { "value": "#0A0E12", "use": "carousel, pinned scroll scenes" }
  },
  "line": {
    "panel": "rgba(35,31,32,.06)",
    "chrome": "rgba(35,31,32,.08)",
    "tag": "rgba(35,31,32,.18)",
    "field": "rgba(35,31,32,.20)",
    "button": "rgba(35,31,32,.28)"
  },
  "font": {
    "display": { "family": "Instrument Serif", "weights": [400], "use": "names, section heads, quotes, fact values", "minSize": 24 },
    "text": { "family": "Work Sans", "weights": [300, 400, 500, 600], "use": "body, buttons, fields", "note": "500 is the heaviest weight in the tools" },
    "label": { "family": "IBM Plex Mono", "weights": [400, 500], "use": "field labels, status, timestamps", "transform": "uppercase", "tracking": "0.2em", "minSize": 10 }
  },
  "typeScale": {
    "heroName": { "size": "clamp(74px, 13vw, 196px)", "lineHeight": 0.82, "tracking": "-0.035em", "font": "display" },
    "sectionHead": { "size": "clamp(36px, 4.4vw, 68px)", "lineHeight": 1.05, "tracking": "-0.02em", "font": "display" },
    "factValue": { "size": "clamp(24px, 2vw, 30px)", "font": "display" },
    "body": { "size": "clamp(17px, 1.35vw, 21px)", "lineHeight": 1.65, "font": "text" },
    "heroLine": { "size": "clamp(17px, 1.6vw, 24px)", "lineHeight": 1.45, "font": "text", "note": "the hero's display line, over the portal photo — larger and looser than body prose" },
    "ui": { "size": 15, "weight": 500, "dense": 13, "font": "text" },
    "monoLabel": { "size": 11, "tracking": "0.2em", "font": "label" },
    "monoFloor": { "size": 10, "tracking": "0.2em", "font": "label", "note": "the mono voice's floor — tile marks and the smallest readouts (DESIGN.md §2)" },
    "carouselFloor": { "size": 24, "note": "nothing smaller on the 1080p carousel" },
    "carouselName": { "size": 190, "lineHeight": 0.86, "tracking": "-0.03em", "font": "display", "note": "the carousel's name (Cat Carousel Motion 6a) — fixed, the frame is always 1920×1080" },
    "carouselLine": { "size": 46, "lineHeight": 1.3, "font": "text", "note": "the carousel's one line under the name" },
    "carouselFact": { "size": 28, "font": "text", "note": "the value in a carousel fact pill" },
    "carouselCardName": { "size": 34, "lineHeight": 1.05, "font": "display", "note": "`{name}'s page` on the QR card" },
    "toolHead": { "size": 38, "lineHeight": 1.1, "tracking": "-0.01em", "font": "display", "note": "builder chrome headings — fixed, never the public clamp" },
    "lockedHead": { "size": 26, "lineHeight": 1.1, "font": "display", "note": "the helper's locked sentence (hi-fi 'Helper locked' card) — the panel's one display moment, above the 24px display floor" },
    "indexName": { "size": "clamp(24px, 2vw, 30px)", "lineHeight": 1, "font": "display", "note": "the index card's name — fact-value with the 24px display floor applied" },
    "heroCardName": { "size": 52, "lineHeight": 0.86, "tracking": "-0.03em", "font": "display", "note": "the builder hero card's name over the full-bleed photo (F28 review #10, comp 3a) — fixed, never the public clamp" }
  },
  "space": { "base": 4, "scale": [4, 6, 8, 12, 16, 20, 28, 40, 56, 80, 120],
    "use": { "4": "icon gaps", "6": "status dots, undo/redo gap", "8": "chips, thumbs", "12": "button stacks", "16": "panel padding", "28": "page gutter", "40": "section rhythm on the phone (below 768px); two sections on the same surface share one unit", "56": "desktop gutter", "120": "section rhythm on the desktop; two sections on the same surface share one unit" } },
  "radius": { "editorial": 0, "control": 4, "panel": 6, "pill": 99 },
  "shadow": {
    "lifted": "0 18px 46px -14px rgba(11,63,99,.28)",
    "screen": "0 30px 70px -28px rgba(11,63,99,.40)",
    "note": "always blue-tinted; nothing on the public profile casts a shadow"
  },
  "focusRing": "0 0 0 3px rgba(11,111,180,.16)",
  "motion": {
    "easing": { "default": "cubic-bezier(.16,.84,.28,1)", "drift": "linear", "progress": "linear", "wipe": "cubic-bezier(.72,0,.16,1)" },
    "duration": { "hover": 180, "panel": 320, "sectionRise": 1000, "beatDefault": 6500, "beatRange": [4000, 12000] },
    "carouselBeat": {
      "slatWipe": { "start": 0, "end": 0.9, "slats": 6, "stagger": 55, "alternatesPerBeat": true },
      "drift": { "scaleFrom": 1.05, "scaleTo": 1.19, "pan": "1.8%", "durationEqualsBeat": true, "flipsPerBeat": true },
      "nameUnmask": { "start": 0.09, "end": 1.3, "trackingFrom": "0.015em", "trackingTo": "-0.03em" },
      "ruleSweep": { "start": 0.04, "staggerAfter": 60 },
      "clearOut": { "start": 5.6, "end": 6.5, "emptyFrameMs": 120 }
    }
  },
  "layout": {
    "profileMaxWidth": 1280,
    "profileGutter": 28,
    "desktopGutter": 56,
    "factsStrip": "repeat(auto-fit, minmax(150px, 1fr))",
    "carousel": { "width": 1920, "height": 1080, "safeInset": { "block": 64, "inline": 96 } },
    "builder": { "rail": 250, "helper": 360, "helperTab": 52, "helperDisc": 26, "topbar": 58 },
    "phone": { "peek": 48 },
    "signInCard": 900
  },
