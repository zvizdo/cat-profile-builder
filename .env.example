# Local defaults. Copy to .env.local; nothing here is a secret. Every variable is
# validated at boot by src/adapters/config.ts (data-model.md, Configuration).

# Which ProfileStore/MediaStore: memory | fs | gcs (ADR-012, ADR-015)
STORE=fs
# Which language model and describer: fake | vertex (ADR-012)
MODEL=fake
# Local folder for the filesystem adapter when STORE=fs (the e2e run uses .data-e2e)
DATA_DIR=.data
# Base of the shareable link and the QR target
PUBLIC_BASE_URL=http://localhost:3000

# Shelter sign-in (ADR-011). `pnpm make-credentials --env` prints the two lines below for a
# password of your choice; paste them in.
SHELTER_USERNAME=shelter
SHELTER_PASSWORD_HMAC=
SESSION_SECRET=

# Google Cloud (ADR-001, ADR-015). Only read when STORE=gcs or MODEL=vertex.
GCS_PRIVATE_BUCKET=
GCS_PUBLIC_BUCKET=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global

# Model ids (ADR-003)
MODEL_DRAFTING=gemini-3.8-flash
MODEL_DESCRIBER=gemini-2.5-flash-lite

# Fake-model controls, only read when MODEL=fake
FAKE_MODEL_SCENARIO=
# Set to `fail` to make the fake describer return { failed } for every call (FR-073)
FAKE_DESCRIBER=

# Set to 1 to make the frame-rate e2e assert instead of record (ADR-009)
FPS_GATE=0

# pino level for the server log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
